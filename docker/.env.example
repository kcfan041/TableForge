# Copy to the repository root as `.env` and replace every secret before first start.
POSTGRES_PASSWORD=change-me-postgres
S3_ACCESS_KEY=tableforge
S3_SECRET_KEY=change-me-storage

# Number of CPU worker containers started by `docker compose up`.
CPU_WORKERS=2

# How many nodes may enroll with the token the coordinator writes to the shared volume,
# and for how long it stays valid.
ENROLLMENT_MAX_USES=16
ENROLLMENT_TTL_MINUTES=1440

# Ports published on 127.0.0.1 only.
COORDINATOR_HOST_PORT=7443
METRICS_HOST_PORT=9464
# Web UI. It stays on 127.0.0.1 even when BIND_ADDRESS is set; share it over the tailnet
# with HTTPS using `tailscale serve --bg --https=443 http://127.0.0.1:8080`.
WEB_HOST_PORT=8080
STORAGE_HOST_PORT=59000

# --- Remote nodes (e.g. a tester over Tailscale) ---
# IP on this machine that the coordinator and storage listen on. Keep 127.0.0.1 unless
# remote nodes must connect; then use this machine's Tailscale IP (tailscale ip -4).
# Avoid 0.0.0.0, which exposes the services on every network.
BIND_ADDRESS=127.0.0.1
# Extra names/IPs the coordinator certificate must cover, comma separated.
# Changing this regenerates the certificate; nodes enrolled earlier need a new invite.
# EXTRA_TLS_HOSTS=100.64.0.1,my-pc.tailnet-name.ts.net
EXTRA_TLS_HOSTS=
# Extra storage addresses offered to nodes, as name=url pairs, comma separated.
# Nodes pick the first one they can reach.
# EXTRA_STORAGE_ENDPOINTS=tailnet=http://100.64.0.1:59000
EXTRA_STORAGE_ENDPOINTS=
